{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mvp-website",

  // Pinned deliberately. This login can see more than one Cloudflare account,
  // and with no account_id set wrangler may pick the wrong one silently. With
  // it pinned, a deploy either goes to this exact account or fails outright.
  // Not a secret — an account id grants nothing without credentials.
  //
  // This is the dedicated "Motion Vitality Pilates" account, kept separate
  // from the personal ones so ownership can transfer to the studio later.
  "account_id": "4173559dfe08c7dd17cbb2e2dcc75a32",

  "compatibility_date": "2026-09-02",

  // Static-only site: `next build` with output:"export" writes ./out, and the
  // assets runtime serves it directly. No Worker script, so no "main" entry.
  "assets": {
    "directory": "./out",

    // Serve /pricing from pricing.html and 404.html for unmatched paths.
    // auto-trailing-slash keeps /pricing and /pricing/ resolving to one page,
    // which avoids duplicate-content pairs in search results.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
