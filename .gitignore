# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw video masters. These live in assets-src/ alongside the photo masters, but
# unlike the photos they stay out of git: "website vid.mp4" is 138MB, past
# GitHub's 100MB per-file hard limit, and nothing references either file. The
# clip the site actually plays is public/assets/video/core-values.mp4, which is
# tracked normally.
assets-src/videos/
